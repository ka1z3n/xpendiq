<?xml version="1.0" encoding="utf-8"?>
<!--
  Full (off-Play) flavor only: bank-SMS capture. These are deliberately absent from the Play
  flavor, which relies on notification access instead, to satisfy Play's SMS/Call Log policy.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />

    <application>
        <receiver
            android:name=".sms.SmsBroadcastReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="100">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
