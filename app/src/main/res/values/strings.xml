    <string name="onb_intro_title">Track every spend, automatically</string>
    <string name="onb_intro_body">Xpendiq reads transactional SMS from your bank, classifies them, and shows where your money goes.</string>
    <string name="onb_intro_b1">🏦 Works with HDFC, SBI, ICICI, Axis &amp; more</string>
    <string name="onb_intro_b2">💸 UPI, credit cards, debit cards, NEFT</string>
    <string name="onb_intro_b3">📂 Auto-categorized — you correct anything wrong</string>
    <string name="onb_intro_b4">🔒 Nothing leaves your phone</string>

    <string name="onb_t1_title">Tidy up your spending</string>
    <string name="onb_t1_body">New transactions land in Uncategorized. Tap one, pick a category, and Xpendiq remembers — it even suggests the rest for you.</string>
    <string name="onb_t2_title">Know your month</string>
    <string name="onb_t2_body">The Insights tab shows your totals, biggest categories, and how this month compares with the last.</string>
    <string name="onb_t3_title">Yours, and portable</string>
    <string name="onb_t3_body">Everything stays on your phone. Turn on App lock for privacy, and export a CSV backup any time you switch phones.</string>

    <string name="onb_perm_emoji">🔐</string>
    <string name="onb_perm_title">We need SMS access</string>
    <string name="onb_perm_body">Bank transactions arrive as SMS. Xpendiq reads only those, on your device.</string>
    <string name="onb_perm_b1">📵 OTPs and promo SMS are filtered out</string>
    <string name="onb_perm_b2">🗑 Deleted transactions don\'t come back</string>
    <string name="onb_perm_b3">⚙️ You can revoke this from Settings any time</string>

    <string name="onb_notif_title">Catch RCS bank alerts too?</string>
    <string name="onb_notif_msg">Some banks (e.g. SBI Card) send alerts over RCS instead of SMS. Turn on notification access so Xpendiq can read those from Google Messages or Samsung Messages. You can change this any time in Settings.</string>
    <string name="onb_notif_enable">Enable</string>
    <string name="onb_notif_skip">Not now</string>

    <string name="onb_backfill_title">Import this month\'s transactions?</string>
    <string name="onb_backfill_msg">Xpendiq can scan this month\'s inbox so you start with your current spending. You can pull older history later from Settings.</string>
    <string name="onb_backfill_run">Run now</string>
    <string name="onb_backfill_skip">Not now</string>

