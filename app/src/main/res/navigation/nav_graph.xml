<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.kaizenll.xpendiq.ui.home.HomeFragment"
        android:label="@string/nav_home" />
    <fragment
        android:id="@+id/transactionsFragment"
        android:name="com.kaizenll.xpendiq.ui.transactions.TransactionsFragment"
        android:label="@string/nav_transactions" />
    <fragment
        android:id="@+id/investmentsFragment"
        android:name="com.kaizenll.xpendiq.ui.investments.InvestmentsFragment"
        android:label="@string/nav_investments" />
    <fragment
        android:id="@+id/insightsFragment"
        android:name="com.kaizenll.xpendiq.ui.insights.InsightsFragment"
        android:label="@string/nav_insights" />
    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.kaizenll.xpendiq.ui.settings.SettingsFragment"
        android:label="@string/nav_settings" />

    <fragment
        android:id="@+id/uncategorizedFragment"
        android:name="com.kaizenll.xpendiq.ui.uncategorized.UncategorizedFragment"
        android:label="@string/uncat_title" />

    <fragment
        android:id="@+id/editTransactionFragment"
        android:name="com.kaizenll.xpendiq.ui.edit.EditTransactionFragment"
        android:label="@string/edit_title">
        <argument
            android:name="txnId"
            app:argType="long"
            android:defaultValue="-1L" />
    </fragment>

    <fragment
        android:id="@+id/categoriesFragment"
        android:name="com.kaizenll.xpendiq.ui.categories.CategoriesFragment"
        android:label="@string/cats_title" />
</navigation>
