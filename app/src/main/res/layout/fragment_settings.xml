<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <!-- Branded header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="4dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_logo_tile"
                android:contentDescription="@string/app_name"
                android:padding="9dp"
                android:src="@drawable/ic_brand_mark" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="@string/settings_title"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                android:textColor="?attr/colorOnSurface" />

        </LinearLayout>

        <!-- PERMISSIONS -->
        <TextView
            style="@style/SettingsSectionHeader"
            android:text="@string/settings_section_permissions" />

        <com.google.android.material.card.MaterialCardView
            style="@style/SettingsGroupCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- SMS access -->
                <LinearLayout
                    android:id="@+id/sms_row"
                    style="@style/SettingsRow">

                    <ImageView
                        style="@style/SettingsRowIcon"
                        android:src="@drawable/ic_forum" />

                    <LinearLayout style="@style/SettingsRowText">

                        <TextView
                            style="@style/SettingsRowTitle"
                            android:text="@string/settings_label_sms" />

                        <TextView
                            style="@style/SettingsRowSubtitle"
                            android:text="@string/settings_label_sms_desc" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/permission_status"
                        style="@style/SettingsStatus"
                        tools:text="Granted" />

                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <!-- Notification access -->
                <LinearLayout
                    android:id="@+id/notif_row"
                    style="@style/SettingsRow">

                    <ImageView
                        style="@style/SettingsRowIcon"
                        android:src="@drawable/ic_notifications" />

                    <LinearLayout style="@style/SettingsRowText">

                        <TextView
                            style="@style/SettingsRowTitle"
                            android:text="@string/settings_label_notif" />

                        <TextView
                            style="@style/SettingsRowSubtitle"
                            android:text="@string/settings_label_notif_desc" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/notif_status"
                        style="@style/SettingsStatus"
                        tools:text="Not granted" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- DATA -->
        <TextView
            style="@style/SettingsSectionHeader"
            android:text="@string/settings_section_data" />

        <com.google.android.material.card.MaterialCardView
            style="@style/SettingsGroupCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Backfill -->
                <LinearLayout
                    android:id="@+id/backfill_row"
                    style="@style/SettingsRow">

                    <ImageView
                        style="@style/SettingsRowIcon"
                        android:src="@drawable/ic_history" />

                    <LinearLayout style="@style/SettingsRowText">

                        <TextView
                            style="@style/SettingsRowTitle"
                            android:text="@string/settings_backfill_label" />

                        <TextView
                            android:id="@+id/backfill_subtitle"
                            style="@style/SettingsRowSubtitle"
                            tools:text="Last 90 days · 0 imported" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/backfill_btn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="6dp"
                        android:text="@string/settings_run"
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        android:textColor="?attr/colorPrimary" />

                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <!-- Manage categories -->
                <LinearLayout
                    android:id="@+id/manage_categories_row"
                    style="@style/SettingsRow">

                    <ImageView
                        style="@style/SettingsRowIcon"
                        android:src="@drawable/ic_grid" />

                    <LinearLayout style="@style/SettingsRowText">

                        <TextView
                            style="@style/SettingsRowTitle"
                            android:text="@string/settings_manage_categories" />

                        <TextView
                            android:id="@+id/categories_subtitle"
                            style="@style/SettingsRowSubtitle"
                            tools:text="14 categories" />

                    </LinearLayout>

                    <ImageView style="@style/SettingsRowChevron" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- BACKUP & RESTORE -->
        <TextView
            style="@style/SettingsSectionHeader"
            android:text="@string/settings_section_backup" />

        <com.google.android.material.card.MaterialCardView
            style="@style/SettingsGroupCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Export -->
                <LinearLayout
                    android:id="@+id/export_row"
                    style="@style/SettingsRow">

                    <ImageView
                        style="@style/SettingsRowIcon"
                        android:src="@drawable/ic_download" />

                    <LinearLayout style="@style/SettingsRowText">

                        <TextView
                            style="@style/SettingsRowTitle"
                            android:text="@string/settings_export" />

                        <TextView
                            style="@style/SettingsRowSubtitle"
                            android:text="@string/settings_export_desc" />

                    </LinearLayout>

                    <ImageView style="@style/SettingsRowChevron" />

                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <!-- Import -->
                <LinearLayout
                    android:id="@+id/import_row"
                    style="@style/SettingsRow">

                    <ImageView
                        style="@style/SettingsRowIcon"
                        android:src="@drawable/ic_upload" />

                    <LinearLayout style="@style/SettingsRowText">

                        <TextView
                            style="@style/SettingsRowTitle"
                            android:text="@string/settings_import" />

                        <TextView
                            style="@style/SettingsRowSubtitle"
                            android:text="@string/settings_import_desc" />

                    </LinearLayout>

                    <ImageView style="@style/SettingsRowChevron" />

                </LinearLayout>

                <TextView
                    android:id="@+id/backup_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="16dp"
                    android:paddingBottom="12dp"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:visibility="gone"
                    tools:text="Imported 124 · skipped 3"
                    tools:visibility="visible" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- PRIVACY -->
        <TextView
            style="@style/SettingsSectionHeader"
            android:text="@string/settings_section_security" />

        <com.google.android.material.card.MaterialCardView
            style="@style/SettingsGroupCard">

            <LinearLayout
                android:id="@+id/app_lock_row"
                style="@style/SettingsRow">

                <ImageView
                    style="@style/SettingsRowIcon"
                    android:src="@drawable/ic_shield" />

                <LinearLayout style="@style/SettingsRowText">

                    <TextView
                        style="@style/SettingsRowTitle"
                        android:text="@string/settings_app_lock" />

                    <TextView
                        style="@style/SettingsRowSubtitle"
                        android:text="@string/settings_app_lock_short" />

                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/app_lock_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ABOUT -->
        <TextView
            style="@style/SettingsSectionHeader"
            android:text="@string/settings_section_about" />

        <com.google.android.material.card.MaterialCardView
            style="@style/SettingsGroupCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/ic_brand_mark" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:id="@+id/version_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        tools:text="Version 1.0" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>
